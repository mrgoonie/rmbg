{
  "name": "rmbg-api",
  "version": "0.0.1",
  "description": "API server for removing backgrounds from images",
  "main": "lib/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrgoonie/rmbg.git",
    "directory": "packages/api"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf lib && tsc && cp -r src/public lib/public",
    "start": "node lib/server.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "onnxruntime-node": "^1.16.2",
    "sharp": "^0.33.0",
    "@rmbg/model-briaai": "workspace:*",
    "@rmbg/model-modnet": "workspace:*",
    "@rmbg/model-silueta": "workspace:*",
    "@rmbg/model-u2netp": "workspace:*",
    "@rmbg/model-isnet-anime": "workspace:*",
    "@rmbg/model-u2net-cloth": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "rimraf": "^5.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}